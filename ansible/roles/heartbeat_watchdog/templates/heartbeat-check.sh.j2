#!/usr/bin/env bash
# {{ ansible_managed }}
#
# "Who watches the watchmen": runs on the bare host, outside k3s's blast
# radius. Hits Alertmanager's /-/healthy over its tailnet hostname; on
# failure, posts to a private ntfy.sh topic. Deliberately a separate
# notification channel from whatever Alertmanager's own receiver ends up
# being, so one channel's failure doesn't take down the other.
#
# Scope: catches "k3s crashed/OOM-killed but the host OS is still up."
# Does NOT cover the laptop itself dying.
set -euo pipefail

ALERTMANAGER_URL="{{ alertmanager_healthy_url }}"
NTFY_TOPIC="{{ ntfy_topic }}"

if ! curl -fsS --max-time 10 "$ALERTMANAGER_URL" > /dev/null; then
    curl -fsS \
        -H "Title: Homelab heartbeat failed" \
        -H "Priority: urgent" \
        -d "Alertmanager did not respond healthy at ${ALERTMANAGER_URL}" \
        "https://ntfy.sh/${NTFY_TOPIC}" > /dev/null
    exit 1
fi
