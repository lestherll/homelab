{#
  Managed by Ansible (host_prereqs). Edit the role, not the live network —
  `virsh net-edit` changes are overwritten on the next converge.

  forward mode='nat': the VM reaches the internet through the host (it must, to
  pull container images) but is not addressable from the LAN. This is what keeps
  the host's ufw rules meaningful, which bridged networking would not.
#}
<network>
  <name>{{ libvirt_talos_network_name }}</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='{{ libvirt_talos_network_bridge }}' stp='on' delay='0'/>
  <ip address='{{ libvirt_talos_network_host_ip }}' netmask='{{ libvirt_talos_network_netmask }}'>
    <dhcp>
      <range start='{{ libvirt_talos_dhcp_range_start }}' end='{{ libvirt_talos_dhcp_range_end }}'/>
      {# Reservation sits outside the range above; libvirt rejects overlap. #}
      <host mac='{{ talos_cp_mac }}' name='{{ talos_cp_hostname }}' ip='{{ talos_cp_ip }}'/>
    </dhcp>
  </ip>
</network>
