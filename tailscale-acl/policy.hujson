// Example/default ACLs for unrestricted connections.
{
    // Declare static groups of users. Use autogroups for all users or users with a specific role.
    // "groups": {
    //      "group:example": ["alice@example.com", "bob@example.com"],
    // },

    // Define the tags which can be applied to devices and by which users.
    // "tagOwners": {
    //      "tag:example": ["autogroup:admin"],
    // },
    // tag:k8s-operator is the operator's own device; tag:k8s is every proxy it
    // creates, which it is therefore allowed to own. tag:ci is worn by an app
    // repo's GitHub Actions runner while it registers itself with the cluster —
    // deliberately ONE tag shared by every app repo, not one tag per repo:
    // per-repo isolation is enforced in the cluster by an admission policy
    // reading the runner's GitHub-signed OIDC claims, so onboarding a new app
    // needs no change to this file.
    // tag:talos is worn by a Talos NODE itself, via the siderolabs/tailscale
    // system extension baked into its installer image — not by anything running
    // inside the cluster. It is the destination for the machine API (:50000),
    // which is the only way into a node with no shell and no SSH, so it must
    // keep working when the cluster does not.
    //
    // Deliberately a TAG rather than a "hosts" entry. The VM's machine API was
    // reached through `talos-cp-01: 10.10.0.10` below, which has to be re-edited
    // every time that address moves; a tag survives a node being renumbered,
    // renamed or replaced, and covers machine 1 the day it joins with no change
    // here. The nodes advertise it themselves — see TS_EXTRA_ARGS in
    // terraform/modules/talos-metal/talos.tf.
    "tagOwners": {
        "tag:k8s-operator": [],
        "tag:k8s":          ["tag:k8s-operator"],
        "tag:ci":           ["autogroup:admin"],
        "tag:talos":        ["autogroup:admin"],
    },

    // Named IPs, referenced only by the `tests` block at the bottom.
    //
    // This exists because a test destination cannot be a MagicDNS name: the
    // policy resolves test hosts against tags, autogroups, entries here, and
    // literal IPs, and nothing else. Writing "homelab:22" without this section
    // fails validation with `unknown user or host` — which is how the tests
    // caught their own first draft.
    //
    // Only the host is listed, and deliberately no proxies. A proxy's tailnet IP
    // changes whenever the operator recreates it, so pinning one here would give
    // a test that breaks on an unrelated redeploy; the proxies are tested
    // through `tag:k8s` instead, which is stable by construction. The host's
    // address is stable because the machine is long-lived — and if it ever does
    // change, this fails loudly rather than silently testing nothing.
    // talos-cp-01 is the Talos VM's address on machine 1's host-only libvirt
    // network. Unlike a proxy IP this one is safe to pin: it is set explicitly
    // as `node_ip` in terraform/clusters/homelab, not handed out by DHCP, so it
    // changes only when someone edits Terraform.
    //
    // It is NOT reachable by virtue of appearing here — a named host is just a
    // label. Reachability comes from machine 1 advertising 10.10.0.0/24 as a
    // subnet router plus the grant below, and from nothing else.
    // SUPERSEDED, and kept only while machine 1 exists: `talos-cp-01` is the
    // VM's address on machine 1's host-only libvirt network, and reaching it
    // needs machine 1 up as a subnet router. The metal nodes replaced that with
    // `tag:talos` — a tag, so no address appears here at all and nothing has to
    // be re-pinned when one moves. Delete this entry, the 10.10.0.0/24
    // autoApprover, its grant and its two tests in the change that wipes
    // machine 1; leaving them behind is a route advertised for a host that no
    // longer exists.
    "hosts": {
        "homelab":     "100.121.11.84",
        "talos-cp-01": "10.10.0.10",
    },

    // Let the operator's proxies advertise the apiserver service without a
    // human approving each one in the console. Scoped to the one service by
    // name rather than "svc:*" — a wildcard here would let any tag:k8s proxy
    // claim any service name it liked, including one a future rule trusts.
    //
    // The route entry lets machine 1 advertise the Talos VM's host-only libvirt
    // network without a console click, so `talosctl` works from the operator's
    // devices instead of only from machine 1's own shell (LES-162). Scoped to
    // the exact /24, never 0.0.0.0/0: a wider entry would let that machine
    // auto-approve itself as an exit node.
    //
    // Approving a ROUTE is not granting access to it. Nothing on 10.10.0.0/24
    // is reachable until the grant below names it, which is why this file can
    // advertise a whole subnet and still expose exactly one port.
    "autoApprovers": {
        "services": {
            "svc:kube-apiserver-metal": ["tag:k8s"],
        },
        "routes": {
            "10.10.0.0/24": ["lestherll@github"],
        },
    },

    // Define grants that govern access for users, groups, autogroups, tags,
    // Tailscale IP addresses, and subnet ranges.
    //
    // Tailscale's default blanket grant — {"src":["*"],"dst":["*"],"ip":["*"]} —
    // was removed here. Everything reachable on this tailnet is now reachable
    // because a rule below says so, which is the point: the previous state made
    // every narrower rule in this file decorative, in exactly the way the
    // cluster's NetworkPolicies were decorative before a policy-capable CNI
    // landed. See the `tests` block at the bottom — the deny cases are what stop
    // this file drifting back to "allows everything" without anyone noticing.
    //
    // What is deliberately NOT granted, so their absence reads as a decision:
    //   - Anything reaching tag:k8s-operator. The operator drives its proxies
    //     through the Kubernetes API from inside the cluster; its tailnet device
    //     exists to be a device, and nothing needs to connect to it.
    //   - Any egress rule for tag:k8s. The proxies receive connections and
    //     originate none over the tailnet. If a proxy ever needs to reach
    //     something, this is the first place to look — the symptom will be a
    //     hang, not an error.
    "grants": [
        // The operator's own devices, to each other, on everything.
        // autogroup:self is scoped to devices owned by the *same user* as the
        // source, so this covers homelab / lesthers-mba / iphone-17 and cannot
        // reach a tagged device — tagged devices have no user owner and are
        // never in autogroup:self.
        //
        // This is also what makes Tailscale SSH work. The "ssh" block below
        // decides who may open a session and as which local user; it does not
        // grant the network reachability to get there, and tcp:22 has to come
        // from a grant like this one. Removing this breaks SSH to the host in a
        // way the ssh block gives no hint about.
        {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},

        // The operator reaching the app exposures.
        //
        // tag:k8s is every proxy the operator creates, which today means the
        // four app/observability Ingress proxies and the apiserver ProxyGroup.
        // There is no finer tag available: the operator applies tag:k8s to all
        // of them, and splitting it would mean per-proxy tag configuration for
        // no gain, since a proxy only ever serves the one workload behind it.
        //
        // Ports are the real scoping here. 443 is what the Ingresses serve; 80
        // is kept because Tailscale Serve answers there with a redirect to 443,
        // and dropping it turns "typed http:// out of habit" into a hang rather
        // than a redirect. Every other port on those devices is denied — an app
        // listening on 8000 in the cluster is not reachable on 8000 here.
        {"src": ["autogroup:member"], "dst": ["tag:k8s"], "ip": ["tcp:80", "tcp:443"]},

        // CI reaching the Kubernetes API server to register its own app.
        // Written before this tightening and previously redundant behind the
        // blanket grant; now it is the only thing making app onboarding work.
        // tcp:443 only: the proxy terminates TLS on the standard port and the
        // apiserver's own 6443 is never exposed to the tailnet.
        //
        // Note the dst is the SERVICE, not tag:k8s. A service grant is separate
        // from a device grant, so the rule above does not imply this one and
        // this one gives CI no access to any app.
        {"src": ["tag:ci"], "dst": ["svc:kube-apiserver-metal"], "ip": ["tcp:443"]},

        // The operator reaching the apiserver over the tailnet (LES-104).
        // Same service as the CI rule above, same noauth proxy — the proxy
        // forwards every request unmodified regardless of caller, so nothing
        // about this rule needs to differ between a human's Google-OIDC token
        // and CI's GitHub token. What used to block this (human access needing
        // its own auth model) is resolved: the apiserver's multi-issuer
        // AuthenticationConfiguration does the identity check, and RBAC
        // (infrastructure/human-auth/) does the authorization.
        {"src": ["autogroup:member"], "dst": ["svc:kube-apiserver-metal"], "ip": ["tcp:443"]},

        // The operator reaching the Talos machine API over the subnet route
        // machine 1 advertises (LES-162; the reachability half of LES-136).
        //
        // THE PORT LIST IS THE SECURITY BOUNDARY HERE, not the route. Routing
        // 10.10.0.0/24 onto the tailnet puts the VM's whole listening surface
        // one grant away, and it is not all authenticated. Audited 2026-08-31
        // from machine 1:
        //
        //   50000 apid          mTLS, Talos CA — no cert, no handshake
        //   50001 trustd        mTLS
        //    6443 apiserver     401 anonymous
        //    2379/2380 etcd     mTLS, etcd CA
        //   10250 kubelet       webhook authn, anonymous disabled
        //    9100 node-exporter *** HTTP 200, NO AUTH ***  <- the reason for tcp:
        //   10256 kube-proxy    unauthenticated
        //
        // node-exporter runs hostNetwork in the privileged observability
        // namespace and will hand its whole metric set to anyone who can reach
        // it. So this grant names tcp:50000 and nothing else. Widening it to
        // ["*"] for convenience silently publishes that endpoint to every
        // device on the tailnet — do not, and if a second port is ever needed,
        // add that port rather than the wildcard.
        //
        // Also expect 10249 (kube-proxy metrics) to open on the next REBUILD:
        // talos.tf sets metrics-bind-address=0.0.0.0 and justifies it with
        // "10.10.0.10 is ... not reachable from the LAN", which this rule is
        // the beginning of the end of. It is still closed today only because
        // bootstrap manifests do not retrofit a running cluster.
        //
        // src is autogroup:member rather than the Mac alone because an ACL src
        // cannot name a single device; on a single-user tailnet this is the
        // operator's own devices. Reachability is only half of access anyway —
        // apid still demands a client cert per device (LES-156).
        {"src": ["autogroup:member"], "dst": ["talos-cp-01"], "ip": ["tcp:50000"]},

        // The same machine API on the METAL cluster, reached a different way:
        // the node is a tailnet device in its own right, so there is no subnet
        // route, no named host and no address in this file at all.
        //
        // That is the whole reason this rule replaces the one above rather than
        // extending it. The rule above depends on machine 1 being up to
        // advertise 10.10.0.0/24 — which routes the bare-metal node's ONLY
        // diagnostic path through a different machine, and "machine 1 is down"
        // is precisely when talosctl is wanted
        // (docs/fleet/fleet-provisioning-design-notes.md §6.4).
        //
        // THE PORT LIST IS STILL THE SECURITY BOUNDARY, and now it is the ONLY
        // boundary — a tailnet device has no subnet route to withhold. Audited
        // on this node 2026-09-03, unchanged from the VM's audit above:
        //
        //    9100 node-exporter *** HTTP 200, NO AUTH ***  <- the reason for tcp:
        //   10256 kube-proxy    unauthenticated
        //   50000 apid          mTLS, Talos CA — no cert, no handshake
        //    6443 apiserver     401 anonymous
        //
        // Widening this to ["*"] hands every tailnet device the node's full
        // metric set. If a second port is ever needed — 6443 for a break-glass
        // kubectl that does not depend on an in-cluster proxy is the likely one,
        // and it needs a matching cluster.apiServer.certSANs entry — add that
        // port, never the wildcard.
        //
        // Reachability is only half of access: apid still demands a client
        // certificate per device, minted with `talosctl config new --roles
        // os:reader --crt-ttl 720h` rather than by copying the admin config.
        // Talos has no CRL, so a short TTL is the only revocation there is.
        {"src": ["autogroup:member"], "dst": ["tag:talos"], "ip": ["tcp:50000"]},

        // Allow users in "group:example" to access "tag:example", but only from
        // devices that are running macOS and have enabled Tailscale client auto-updating.
        // {"src": ["group:example"], "dst": ["tag:example"], "ip": ["*"], "srcPosture":["posture:autoUpdateMac"]},
    ],

    // Define postures that will be applied to all rules without any specific
    // srcPosture definition.
    // "defaultSrcPosture": [
    //      "posture:anyMac",
    // ],

    // Define device posture rules requiring devices to meet
    // certain criteria to access parts of your system.
    // "postures": {
    //      // Require devices running macOS, a stable Tailscale
    //      // version and auto update enabled for Tailscale.
    //     "posture:autoUpdateMac": [
    //         "node:os == 'macos'",
    //         "node:tsReleaseTrack == 'stable'",
    //         "node:tsAutoUpdate",
    //     ],
    //      // Require devices running macOS and a stable
    //      // Tailscale version.
    //     "posture:anyMac": [
    //         "node:os == 'macos'",
    //         "node:tsReleaseTrack == 'stable'",
    //     ],
    // },

    // Define users and devices that can use Tailscale SSH.
    "ssh": [
        // Allow all users to SSH into their own devices in check mode.
        // Comment this section out if you want to define specific restrictions.
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
    ],

    // Test access rules every time they're saved.
    //
    // These run on every PR (the workflow's `test` mode) without touching the
    // tailnet, and again on apply. They exist because the failure mode this file
    // has is silent: a rule that is too WIDE breaks nothing and is invisible
    // until someone re-reads the file. So every test below pairs an accept with
    // a deny, and the denies are the half that matters — an accept-only suite
    // passes just as happily against the blanket grant this change removed.
    //
    // Destinations are TAGS, plus the one named host above. A MagicDNS device
    // name is NOT resolvable here — the first draft of this block used
    // "fastapi-echo:443" and friends and failed validation outright with
    // `unknown user or host`. Tags are the better target anyway: they survive a
    // proxy being recreated under a new name or address, and they express the
    // rule being tested ("proxies are reachable on 443") rather than one
    // instance of it.
    "tests": [
        // The proxies: reachable on what Tailscale actually serves, and on
        // nothing else.
        //
        // The denies are the load-bearing half. 8000 / 3000 / 9093 are the ports
        // fastapi-echo, Grafana and Alertmanager listen on *inside the cluster*;
        // if any of them starts passing, a rule has been widened from the served
        // ports to the whole device. tag:k8s-operator is granted to nobody and
        // is the closest thing here to a control-plane device — if it becomes
        // reachable, a rule has been widened to tags in general.
        {
            "src":    "lestherll@github",
            "accept": ["tag:k8s:443", "tag:k8s:80"],
            "deny": [
                "tag:k8s:22",
                "tag:k8s:8000",
                "tag:k8s:3000",
                "tag:k8s:9093",
                "tag:k8s-operator:443",
                "tag:k8s-operator:22",
            ],
        },

        // SSH to the host. This is the one case that needs the "hosts" entry:
        // it asserts the tcp:22 reachability that Tailscale SSH depends on and
        // that the "ssh" block below does not itself grant, so deleting the
        // autogroup:self rule fails here rather than in a terminal later.
        {
            "src":    "lestherll@github",
            "accept": ["homelab:22"],
        },

        // CI must reach nothing but the apiserver service. Every deny is a real
        // regression: an app repo's runner reaching an app exposure, reaching
        // the operator's device, or reaching the host over SSH.
        //
        // Deliberately deny-only. The matching accept would be the grant on
        // svc:kube-apiserver-metal, and a VIP service is not a destination this
        // tests block can name. That rule's real test is app registration
        // continuing to work; see docs/zero-touch-app-registration.md.
        {
            "src":  "tag:ci",
            "deny": ["tag:k8s:443", "tag:k8s:80", "tag:k8s-operator:443", "homelab:22"],
        },

        // The Talos machine API over the subnet route, and — the half that
        // matters — everything else on that VM staying shut.
        //
        // 9100 is node-exporter, which answers HTTP 200 with no authentication
        // whatsoever; if that deny ever starts failing, the grant has been
        // widened and the VM's full metric set is on the tailnet. 6443, 2379
        // and 10250 are authenticated, so reaching them is not immediately a
        // breach — they are here because reachability beyond one port means the
        // port list was replaced by a wildcard, which is the actual mistake to
        // catch. 22 is included though Talos runs no SSH at all: it asserts the
        // rule is scoped to a port rather than to the host.
        {
            "src":    "lestherll@github",
            "accept": ["talos-cp-01:50000"],
            "deny": [
                "talos-cp-01:9100",
                "talos-cp-01:10256",
                "talos-cp-01:6443",
                "talos-cp-01:2379",
                "talos-cp-01:10250",
                "talos-cp-01:22",
            ],
        },

        // CI has no business on the machine API — it registers Flux objects
        // through the apiserver service and nothing else. Without this, a
        // future widening of the grant above from autogroup:member to a tag
        // would hand an app repo's runner node-level access.
        {
            "src":  "tag:ci",
            "deny": ["talos-cp-01:50000", "talos-cp-01:9100"],
        },

        // The same pair for the metal nodes, which are reached by TAG rather
        // than through a subnet route. Same shape, same reasoning, and the
        // denies matter more here: a tag has no route to withhold, so this
        // port list is the only thing standing between an unauthenticated
        // :9100 and every device on the tailnet.
        //
        // 22 is included though Talos runs no SSH at all — it asserts the rule
        // is scoped to a port rather than to the device, which is exactly what
        // replacing the list with ["*"] would undo.
        {
            "src":    "lestherll@github",
            "accept": ["tag:talos:50000"],
            "deny": [
                "tag:talos:9100",
                "tag:talos:10256",
                "tag:talos:6443",
                "tag:talos:2379",
                "tag:talos:10250",
                "tag:talos:22",
            ],
        },

        {
            "src":  "tag:ci",
            "deny": ["tag:talos:50000", "tag:talos:9100", "tag:talos:6443"],
        },
    ],
}
